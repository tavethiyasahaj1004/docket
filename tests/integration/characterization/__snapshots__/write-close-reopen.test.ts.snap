exports[`PATCH /api/tickets/[id]/close + /reopen (characterization) > close > customer-token errors: wrong token 404, unknown id 404, closed 400, merged shell 409 (not forwarded) 1`] = `
{
  "closed": {
    "body": {
      "error": "Ticket is already closed.",
    },
    "status": 400,
  },
  "merged": {
    "body": {
      "error": "This ticket was merged into another ticket, so it can't be changed. Refresh the page to open the ticket it was merged into.",
    },
    "status": 409,
  },
  "unknown": {
    "body": {
      "error": "Ticket not found.",
    },
    "status": 404,
  },
  "wrong": {
    "body": {
      "error": "Ticket not found.",
    },
    "status": 404,
  },
}
`;

