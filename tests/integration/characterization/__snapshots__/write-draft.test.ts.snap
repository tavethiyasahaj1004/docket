exports[`PUT/DELETE /api/tickets/[id]/draft (characterization) > PUT > empty content for an unknown ticket is still 200 {draft:null} (existence is checked only for non-empty drafts) 1`] = `
{
  "empty": {
    "body": {
      "draft": null,
    },
    "status": 200,
  },
  "nonEmpty": {
    "body": {
      "error": "Ticket not found.",
    },
    "status": 404,
  },
}
`;

