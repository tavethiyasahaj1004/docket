exports[`PUT/DELETE /api/tickets/[id]/draft (characterization) > DELETE > is idempotent: no draft -> still 200 {draft:null}; unknown ticket too 1`] = `
{
  "body": {
    "draft": null,
  },
  "status": 200,
}
`;

exports[`PUT/DELETE /api/tickets/[id]/draft (characterization) > DELETE > merged shell -> 409; no session -> 401 1`] = `
{
  "anon": {
    "body": {
      "error": "Unauthorized.",
    },
    "status": 401,
  },
  "merged": {
    "body": {
      "error": "This ticket was merged into another ticket, so it can't be changed. Refresh the page to open the ticket it was merged into.",
    },
    "status": 409,
  },
}
`;

