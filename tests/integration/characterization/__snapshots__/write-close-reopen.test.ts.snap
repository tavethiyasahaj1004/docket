exports[`PATCH /api/tickets/[id]/close + /reopen (characterization) > reopen > errors: not closed 400, merged 409, unknown 404, no auth 401 1`] = `
{
  "anon": {
    "body": {
      "error": "Unauthorized.",
    },
    "status": 401,
  },
  "customerOpen": {
    "body": {
      "error": "Ticket is not closed.",
    },
    "status": 400,
  },
  "merged": {
    "body": {
      "error": "This ticket was merged into another ticket, so it can't be changed. Refresh the page to open the ticket it was merged into.",
    },
    "status": 409,
  },
  "open": {
    "body": {
      "error": "Ticket is not closed.",
    },
    "status": 400,
  },
  "unknown": {
    "body": {
      "error": "Ticket not found.",
    },
    "status": 404,
  },
  "wrongToken": {
    "body": {
      "error": "Ticket not found.",
    },
    "status": 404,
  },
}
`;

