// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`GET /api/stats/volume (characterization) > RECORDS what ?days=abc does today (NaN edge case; not fixed) 1`] = `
{
  "kind": "threw",
  "message": "Invalid time value",
  "name": "RangeError",
}
`;

exports[`GET /api/stats/volume (characterization) > RECORDS what an empty ?days= does today (parseInt of empty string is NaN too) 1`] = `
{
  "kind": "threw",
  "message": "Invalid time value",
  "name": "RangeError",
}
`;

